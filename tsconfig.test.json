{
  /* Unit and integration tests need BOTH DOM types (they exercise browser-facing
     modules) and Node types (they spawn processes and touch the filesystem).
     Keeping this separate from tsconfig.json means src/** still cannot reach for
     a Node API by accident — which matters most for src/sim, where any I/O would
     break determinism. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],

    /* The Phase 4 asset pipeline under tools/ is run directly by Node's type
       stripping (`node tools/asset-pipeline/cli.ts`), which cannot resolve an
       extensionless relative import, so its modules write the extension. The
       tests that exercise those modules pull them into this project. Same
       reasoning and same option as tsconfig.node.json, and safe for the same
       reason: this project emits nothing. */
    "allowImportingTsExtensions": true
  },
  "include": [
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/perf/**/*.ts",
    "src/**/*.ts",
    "src/**/*.svelte"
  ]
}
