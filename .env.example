# ─────────────────────────────────────────────────────────────────────────────
# Evolutionary Tycoon — environment variables
#
# SECURITY: every VITE_-prefixed variable is inlined into the client bundle and
# is therefore PUBLIC. Never put a secret behind a VITE_ prefix.
# Real values live in Vercel project settings and in a local .env.local
# (gitignored). See docs/WORKING_DISCIPLINE.md §9.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for game assets. Defaults to "/" (served from the same origin).
# This exists from day one so that moving /assets/** to an object store + CDN
# is a one-line change if Vercel bandwidth becomes the binding constraint
# (docs/RESEARCH_NOTES.md §9). PUBLIC.
VITE_ASSET_BASE_URL=/

# Cookieless analytics on/off. PUBLIC.
VITE_ENABLE_ANALYTICS=false

# Error reporting DSN. Empty means the reporting module is never loaded at all.
# PUBLIC by nature (a DSN is an ingest endpoint, not a credential).
VITE_SENTRY_DSN=

# Developer overlay (tick counter, entity counts, world hash). Preview only. PUBLIC.
VITE_DEBUG_PANEL=false

# Server-time reference endpoint used by offline progression (Phase 14). PUBLIC.
VITE_TIME_ENDPOINT=/api/time

# ─────────────────────────────────────────────────────────────────────────────
# CI / tooling only — NOT exposed to the client
# ─────────────────────────────────────────────────────────────────────────────

# Playwright target override. Set by the preview-e2e workflow to the live
# Vercel preview URL so E2E runs against the real CDN, headers and cache policy.
# E2E_BASE_URL=https://evolutionary-tycoon-xxxx.vercel.app
