{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],

    /* Vite's native config loader cannot resolve an extensionless relative
       import, and it is planned to become the default. Writing the extension
       keeps `vite.config.ts` working through that change; this option makes
       TypeScript accept it, and is safe here because the project emits nothing.
       Same forward-compatibility reasoning as dropping `baseUrl` in Phase 1. */
    "allowImportingTsExtensions": true,

    /* The benchmark harness under tools/ imports the simulation directly, which
       pulls src/** into this project. Without the alias map those imports fail
       to resolve here even though they resolve in the browser project. */
    "paths": {
      "@app/*": ["./src/app/*"],
      "@sim/*": ["./src/sim/*"],
      "@render/*": ["./src/render/*"],
      "@ui/*": ["./src/ui/*"],
      "@config/*": ["./src/config/*"],
      "@persistence/*": ["./src/persistence/*"],
      "@platform/*": ["./src/platform/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.bench.config.ts",
    "vitest.balance.config.ts",
    "playwright.config.ts",
    "vercel.ts",
    "tools/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/visual/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".vercel"]
}
