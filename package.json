{
  "name": "evolutionary-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "2D isometric roadside restaurant tycoon — traffic is the demand curve.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.13.1 <25",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot",
    "knip": "knip",
    "assets:validate": "node tools/asset-pipeline/cli.ts validate",
    "assets:process": "node tools/asset-pipeline/cli.ts process",
    "assets:atlas": "node tools/asset-pipeline/cli.ts atlas",
    "assets:audio": "node tools/asset-pipeline/cli.ts audio",
    "assets:manifest": "node tools/asset-pipeline/cli.ts manifest",
    "assets:report": "node tools/asset-pipeline/cli.ts report",
    "assets:contact-sheet": "node tools/asset-pipeline/cli.ts contact-sheet",
    "assets:prompts": "node tools/asset-pipeline/cli.ts prompts",
    "assets:build": "node tools/asset-pipeline/cli.ts build",
    "placeholders:build": "node tools/placeholders/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:determinism": "vitest run tests/unit/determinism",
    "bench:sim": "vitest run --config vitest.bench.config.ts",
    "e2e": "playwright test --project=chromium --project=firefox",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:smoke": "playwright test --project=webkit-smoke",
    "e2e:install": "playwright install --with-deps",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "docker run --rm --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble bash -lc 'mkdir -p /tmp/bin && corepack enable --install-directory /tmp/bin && export PATH=/tmp/bin:$PATH && pnpm install --frozen-lockfile && pnpm build && pnpm exec playwright test --project=visual --update-snapshots'",
    "size": "size-limit",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm depcruise && pnpm knip && pnpm assets:validate && pnpm assets:build && pnpm test:coverage && pnpm bench:sim && pnpm build && pnpm size",
    "prepare": "husky"
  },
  "dependencies": {
    "idb": "8.0.3",
    "phaser": "4.2.1",
    "svelte": "5.56.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.2.0",
    "@vercel/config": "0.6.1",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "free-tex-packer-core": "0.3.9",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.3",
    "size-limit": "13.0.3",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "name": "app entry (js, gzip)",
      "path": "dist/assets/*.js",
      "limit": "550 kB",
      "gzip": true
    },
    {
      "name": "app styles (css, gzip)",
      "path": "dist/assets/*.css",
      "limit": "30 kB",
      "gzip": true
    }
  ]
}
